
#include <stdio.h>
int main() {
    float marks, percentage;
    printf("Enter marks out of 500: ");
    scanf("%f", &marks);
    percentage = (marks / 500) * 100;
    printf("Percentage = %.2f%%\n", percentage);
    if (percentage >= 75)
        printf("Grade: Distinction");
    else if (percentage >= 60)
        printf("Grade: First Class");
    else if (percentage >= 40)
        printf("Grade: Pass");
    else
        printf("Grade: Fail");
    return 0;
}
